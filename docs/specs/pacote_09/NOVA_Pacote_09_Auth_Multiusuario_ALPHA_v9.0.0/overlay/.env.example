# Banco PostgreSQL NOVO e isolado de Preview (nunca colar credenciais no GitHub)
DATABASE_URL="postgresql://usuario:senha@host-pooler:5432/nova_preview?sslmode=require"
# Manter cadastro fechado em Preview até revisão de segurança
NOVA_ALLOW_REGISTRATION="false"
NOVA_PUBLIC_URL="https://seu-preview.vercel.app"
# E-mail opcional: recuperação só é enviada se as três variáveis estiverem presentes
RESEND_API_KEY=""
NOVA_EMAIL_FROM=""

# Sempre false até testes completos de isolamento, cálculo e idempotência
NOVA_ENABLE_FINANCIAL_WRITES="false"
