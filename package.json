{
  "name": "nova-plataforma-financeira",
  "version": "9.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/sql-local.mjs ensure && next dev",
    "dev:p06": "node apps/api/src/server.mjs",
    "dev:p07": "node apps/api/src/local.mjs",
    "dev:preview": "node apps/dev-server/server.mjs",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate",
    "start": "next start",
    "lint": "tsc --noEmit && node tools/preflight.mjs && node scripts/p09-check.mjs",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate --schema apps/api/prisma/schema.prisma && vitest run && node --test apps/api/test/*.test.mjs tests/p09-structural.test.mjs && prisma generate",
    "test:p06": "node --test apps/api/test/*.test.mjs",
    "test:p05-node": "node --test apps/dev-server/test/domain.test.mjs",
    "sql:start": "node scripts/sql-local.mjs start",
    "sql:stop": "node scripts/sql-local.mjs stop",
    "sql:status": "node scripts/sql-local.mjs status",
    "sql:check": "node scripts/sql-local.mjs ensure && node --env-file=.env scripts/sql-local.mjs check",
    "db:generate": "prisma generate",
    "db:generate:p06": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "node scripts/sql-local.mjs ensure && prisma migrate dev",
    "db:dev": "node scripts/sql-local.mjs ensure && prisma migrate dev",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "node scripts/sql-local.mjs ensure && prisma studio",
    "db:studio:p06": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:push": "node scripts/sql-local.mjs ensure && prisma db push",
    "preflight:p08": "node tools/preflight.mjs",
    "p09:check": "node scripts/p09-check.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.32",
    "prisma": "^6.11.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "engines": {
    "node": ">=20"
  }
}
