{
  "name": "nova-plataforma-financeira",
  "version": "8.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:p06": "node apps/api/src/server.mjs",
    "dev:p07": "node apps/api/src/local.mjs",
    "dev:preview": "node apps/dev-server/server.mjs",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "prisma generate --schema apps/api/prisma/schema.prisma && vitest run && node --test apps/api/test/*.test.mjs",
    "test:p06": "node --test apps/api/test/*.test.mjs",
    "test:p05-node": "node --test apps/dev-server/test/domain.test.mjs",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "db:push": "prisma db push",
    "preflight:p08": "node tools/preflight.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.5.0",
    "lucide-react": "^0.475.0",
    "next": "15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "prisma": "^6.11.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
